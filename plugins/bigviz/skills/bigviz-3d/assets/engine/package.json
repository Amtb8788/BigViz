{
  "name": "bigviz-3d-engine",
  "private": true,
  "version": "3.0.0",
  "description": "BigViz 3D engine: data-driven, entity-based, time-driven miniature 3D worlds on a desk (three.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test \"test/**/*.test.js\"",
    "validate": "node ../../scripts/validate-scene.mjs src/scenes",
    "verify": "node ../../scripts/verify.mjs",
    "record": "node ../../scripts/record.mjs",
    "new-scene": "node ../../scripts/new-scene.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
